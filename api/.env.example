# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
API_PORT=8000
# Comma-separated allowed CORS origins. Defaults to localhost dev servers if not set.
CORS_ORIGINS=
# Set to true to remove DRAFT watermark from generated PDF reports.
AUDIT_COMPLETE=
# Team API keys — one per engineer, comma-separated. Each engineer sets the matching
# VITE_API_KEY (web) or EXPO_PUBLIC_API_KEY (mobile) in their local .env file.
API_KEYS=mex-hugh-2026,mex-eion-2026,mex-jie-2026,mex-sam-2026,mex-russell-2026

# DigitalOcean Spaces photo storage (leave blank to use local filesystem).
# Create a Spaces bucket at cloud.digitalocean.com, then generate an access key.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=mex-safety-photos
SPACES_REGION=syd1
SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
