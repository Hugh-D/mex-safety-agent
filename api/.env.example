# Copy this file to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
API_PORT=8000
# Comma-separated allowed CORS origins. Defaults to localhost dev servers if not set.
CORS_ORIGINS=
# Set to true to remove DRAFT watermark from generated PDF reports.
AUDIT_COMPLETE=
