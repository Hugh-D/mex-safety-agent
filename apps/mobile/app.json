{
  "expo": {
    "name": "MEX Safety Mobile",
    "slug": "mex-safety-mobile",
    "version": "0.1.0",
    "sdkVersion": "54.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "jsEngine": "hermes",
    "main": "App.tsx",
    "plugins": ["expo-audio"],
    "android": {
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MEX Safety uses the microphone to record voice notes for hazard assessment."
      }
    }
  }
}
